    "nx": "23.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "@lukeed/csprng": "^1.1.0"
  }
