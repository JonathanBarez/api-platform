{
  "name": "api-platform-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22.15.0 || ^26.0.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "capabilities/*",
    "backend-adapters/*",
